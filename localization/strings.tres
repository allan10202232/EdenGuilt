[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://localization/catalog_resource.gd" id="1"]

[resource]
script = ExtResource("1")
messages = {
  "遗庭 / %s": "Eden / %s",
  "E 吸收 / R 交还 · F1 光刃接口试用（地点待定）": "E learn / R return · F1 trial blade",
  "尖刺 -25": "Spikes -25",
  "深渊": "Abyss",
  "折返起点 →": "Turn back here →",
  "下一场景 →": "Next area →",
  "返程交还二段跳、冲刺、护盾后，从这里回家。": "Return Double Jump, Dash and Shield, then come home here.",
  "屏障保护": "Protected route",
  "E 吸收": "E Learn",
  "R 交还": "R Return",
  "已交还 / 通路恢复": "Returned / route restored",
  "%s能力源\n%s": "%s source\n%s",
  "普通地形会挡住黑穿；无有效位移不记排放。": "Ordinary terrain blocks Shadow Pierce. No movement means no emission charge.",
  "伊甸城 · 能源守卫": "Eden City · Energy Warden",
  "即将喷发": "Toxic surge incoming",
  "大地的余绿正在汇聚……": "The land's remaining life gathers…",
  "新能力：%s": "New ability: %s",
  "V 循环拆解": "V Recycle",
  "%s · C 固化毒雾": "%s · C Mineralize",
  "A/D 移动 · 空格跳跃\n灯火：检查点": "A/D Move · Space Jump\nLanterns: checkpoints",
  "真相档案 →": "Truth archive →",
  "下一关 →": "Next level →",
  "地脉提取器已拾取。左键短砍 / 右键长砍；能力源按 E。每次技能都会写入碳账本。": "Extractor recovered. LMB close slash / RMB reach slash. E learns at a source. Skills leave a carbon record.",
  "3 位居民已共同打通伊甸城公共路线。向左回两个能力源卸下护盾和黑穿。": "Three residents opened Eden's public route. Return left to both sources to unload Shield and Shadow Pierce.",
  "循环拆解完成：材料回收 +%.0f kg；矿石替代量为教学估算，见审计报告。": "Recycled: +%.0f kg material. Ore substitution is a teaching estimate; see the audit.",
  "净化门仍关闭：按 I → II → III 的顺序固化三个毒雾节点。": "Purification gate sealed. Mineralize I → II → III in order.",
  "本关的%s尚未获得，返回发光的能力源按 E。": "You still need %s. Return to the glowing source and press E.",
  "伊甸守卫仍在保护能源档案，先击败它再揭开真相。": "The Energy Warden guards the archive. Defeat it to uncover the truth.",
  "先在紫色能力源学会黑穿（F），再进入能源档案。": "Learn Shadow Pierce (F) at the violet source before entering the archive.",
  "向右探索垃圾场、毒雾矿洞、伊甸城。选择逆向循环后从这里回家。": "Explore the Junkyard, Toxic Cavern and Eden City to the right. Choose restoration to return home.",
  "伊甸守卫已倒下。右侧能源档案已解锁：伊甸城的绿色由谁承担代价？": "The Energy Warden has fallen. The archive to the right is open. Who pays for Eden's spring?",
  "R 与居民修复并卸下": "R Restore & unload",
  "已学会 · 向右寻找真相": "Learned · seek the truth →",
  "%s之灵\n%s": "%s essence\n%s",
  "E  吸收能力": "E Learn ability",
  "通路已恢复": "Route restored",
  "R 卸下黑穿": "R Unload Shadow Pierce",
  "F 可用 · 向右探索": "F Ready · explore →",
  "黑穿 · +200 kg\n%s": "Shadow Pierce · +200 kg\n%s",
  "E 学习 / F 释放": "E Learn / F Cast",
  "暗壁已拆除": "Dark wall dismantled",
  "R 居民共建 · 向左返程": "R Rebuild together · return ←",
  "先到伊甸城发现真相，再决定提取器的未来。": "Discover the truth in Eden City before deciding the extractor's future.",
  "毒雾仍在回流。先固化前一个编号节点，再处理这里。": "Toxins are flowing back. Mineralize the previous numbered seal first.",
  "碳矿化 +1 kg；本节点固定 %.0f kg CO₂（游戏模型），晶桥已生成。": "Mineralization +1 kg. Node stores %.0f kg CO₂ (game model); crystal bridge formed.",
  "在空中前方生成临时晶台，或靠近毒雾节点再按 C；无效释放不记排放。": "Create a temporary crystal platform ahead in the air, or press C near a toxin node. Rejected casts are free.",
  "三个封印已完成。毒源停止，净化门已打开，前往 Eden City。": "All three seals are fixed. The toxin sources stop; the gate to Eden City is open.",
  "垃圾场": "Junkyard",
  "出生地 · 捡到地脉提取器。E 学二段跳，每次空中追加跳跃 +5 kg CO₂。": "Recover the extractor. E learns Double Jump; each extra aerial jump adds 5 kg CO₂.",
  "毒雾矿洞": "Toxic Cavern",
  "解谜：I 晶桥 → II 上游毒源 → III 下游毒源。按 C 矿化，集齐三个封印打开净化门。": "Puzzle: I Crystal bridge → II Upstream vent → III Downstream vent. C fixes each seal to open the gate.",
  "伊甸城": "Eden City",
  "E 学盾（Q +20 kg）与黑穿（F +200 kg）。这 10% 净土的代价流向哪里？": "Learn Shield (Q +20 kg) and Shadow Pierce (F +200 kg). Who pays for this green 10%?",
  "T · 交谈": "T · Talk",
  "同行的居民": "A fellow resident",
  "我们会一起修好回家的路。力量可以交还，你不必独自承担。": "We will rebuild the road home together. You can return these powers; you need not carry everything alone.",
  "回到每处能力源按 R。累计碳账本不会清零，但大地可以重新生长。": "Press R at each source. The carbon ledger will remember, but the land can grow again.",
  "莫斯 · 拾荒者": "Moss · Scavenger",
  "你醒在垃圾场。城里丢下的东西，最终都会来到这里。": "You woke in the Junkyard. Everything the city throws away eventually reaches us.",
  "地面的余绿还能回应提取器。在前方能力源按 E，让它们汇聚，学会二段跳。": "The green life in the soil still answers the extractor. Press E at the source ahead to gather it and learn Double Jump.",
  "空格起跳，在空中再按一次可越过断崖。每次二段跳会留下 5 kg 的模拟碳排放。": "Press Space to jump, then again in midair to cross the chasm. Each double jump records 5 kg of simulated CO₂.",
  "向右穿过矿洞，你会看到 Eden City。别只相信城墙内的春天。": "Head right through the cavern to Eden City. Do not trust only the spring inside its walls.",
  "艾拉 · 矿工": "Ayla · Miner",
  "矿洞的毒素来自伊甸城的废气。碰到浓雾会中毒，离开毒雾后会慢慢恢复。": "The cavern's toxins come from Eden's exhaust. Dense fog builds poison; leave it to recover.",
  "先在能力源按 E 学习碳矿化，再按 C 固化节点。每次成功施法记 1 kg。": "First press E at the source to learn Carbon Mineralization. Press C at a node. Each accepted cast records 1 kg.",
  "石刻给出了次序：I 晶桥，II 上游喷口，III 下游喷口。先接通晶桥，再依次封住两处毒源。": "Read the carvings: I Crystal bridge, II Upstream vent, III Downstream vent. Connect the bridge, then seal the two sources in order.",
  "三个封印全部固定，出口的净化门才会打开。走错顺序不会消耗碳排放。": "The purification gate opens only when all three seals are fixed. An out-of-order attempt costs nothing.",
  "赛恩 · 守档人": "Senn · Archivist",
  "欢迎来到 Eden City。这里的绿色并没有消除污染，只是把它送到了别人看不见的地方。": "Welcome to Eden City. Its greenery did not remove the pollution. It sent it where nobody here would see.",
  "城内有两处能力源。学习护盾后用 Q 防御，学习黑穿后用 F 穿过紫色暗壁。": "There are two sources in the city. Learn Shield, then Q to guard; learn Shadow Pierce, then F through violet dark walls.",
  "击败能源守卫，进入右侧档案。是否公开真相，由你决定。": "Defeat the Energy Warden and enter the archive to the right. Revealing the truth will be your choice.",
  "近身挥砍": "Close Slash",
  "近身\n70 px": "Nearby\n70 px",
  "长距离\n165 px": "Reach\n165 px",
  "范围外\n300 px": "Out of range\n300 px",
  "身后\n70 px": "Behind\n70 px",
  "%s 命中：伤害 %d；每刀每目标只结算一次": "%s hit: %d damage; one hit per target per slash",
  "光刃已为本测试房开启。先原地朝右，比较左键和右键的命中范围。": "The blade is enabled in this room. Face right and compare LMB with RMB.",
  "木桩与角色位置已重置；原地左键命中近身木桩，右键还能命中长距离木桩。": "Dummies and position reset. LMB hits nearby; RMB also reaches the farther dummy.",
  "%s：范围 %.0f px · 前摇 %.2f s · 生效 %.2f s · 后摇 %.2f s · 冷却 %.2f s": "%s: %.0f px · windup %.2f s · active %.2f s · recovery %.2f s · cooldown %.2f s",
  "二段跳": "Double Jump",
  "空格": "Space",
  "枝干搭桥，让伙伴回家": "Branches form a bridge home",
  "冲刺": "Dash",
  "根系顶开残骸，形成步行通道": "Roots clear a walking route",
  "护盾": "Shield",
  "关闭矿厂危险喷口，修复伙伴通路": "Shut the vents and restore the path",
  "光刃": "Light Blade",
  "左短 / 右长": "LMB / RMB",
  "地点待定；交还前必须确认撤离通路": "Confirm a safe unarmed escape before returning",
  "碳矿化": "Mineralize",
  "居民共同固化毒雾、修筑晶桥": "Residents mineralize toxins and build crystal bridges",
  "黑穿": "Shadow Pierce",
  "居民拆除专用暗壁，打开公共通路": "Residents dismantle dark walls for everyone",
  "本局没有审计数据。": "No audit data exists for this run.",
  "无法创建审计目录：%s": "Cannot create audit directory: %s",
  "审计文件写入失败：%s": "Cannot write audit file: %s",
  "审计文件写入未完成。": "Audit file could not be fully written.",
  "A · 把绿色还给世界": "A · Return green to the world",
  "B · 边界以内的春天": "B · Spring inside the walls",
  "力量曾让你独自越过深渊。回家的桥，却是和别人一起修好的。账本没有忘记过去，世界仍可从下一次选择开始改变。": "Power let you cross the abyss alone. The bridge home was built together. The ledger remembers the past; the world can still change with the next choice.",
  "你保住了窗内的春天。窗外的人仍替你呼吸。世界没有变得更轻，只是有人把重量移出了视线。": "You kept the spring behind your window. Those outside still breathe its price. The world did not become lighter; its weight was moved out of sight.",
  "<svg viewBox=\"0 0 720 170\" role=\"img\" aria-label=\"各关技能碳排放柱状图\">": "<svg viewBox=\"0 0 720 170\" role=\"img\" aria-label=\"Skill emissions by level\">",
  "三幕技能碳排放 · kg CO₂": "Skill emissions by chapter · kg CO₂",
  "碳之书  ·  永久账本": "Book of Carbon · Permanent ledger",
  "已固定 %.1f kg  ·  当前负荷 %.1f kg": "Stored %.1f kg  ·  Load %.1f kg",
  "能效 —": "Exergy —",
  "能效 %.0f%%": "Exergy %.0f%%",
  "废热 %.0f%%": "Heat %.0f%%",
  "节奏就绪": "Rhythm ready",
  "下次节奏 %.2f 秒": "Next beat %.2f s",
  "空气安宁": "Air is calm",
  "雾霾渐浓": "Haze is gathering",
  "气候失序 · 敌人狂暴": "Climate unrest · enemies enraged",
  "重度污染 · 敌人狂暴": "Severe pollution · enemies enraged",
  "结束交谈": "End conversation",
  "继续 · Enter / T": "Continue · Enter / T",
  "未获得": "Unlearned",
  "可用": "Ready",
  "已交还": "Returned",
  "防御中": "Guarding",
  "完整": "Intact",
  "荒芜": "Bleached",
  "%s · %s   |   土地：%s   |   检查点：%s": "%s · %s   |   Land: %s   |   Lantern: %s",
  "返程": "Homeward",
  "去程": "Outward",
  "目标 ← 档案门口 R 与居民共建通路，再回两处能力源卸下能力。": "← Press R at the archive to rebuild together, then revisit both sources.",
  "目标 ← 紫色能力源 R 卸下黑穿；伊甸城有两处能力源。": "← R at the violet source to unload Shadow Pierce. Eden has two sources.",
  "目标 ← 绿色能力源 R 卸下护盾，再从本关左端返回矿洞。": "← R at the green source to unload Shield, then return left to the cavern.",
  "目标 ← 两种能力已卸下，从左端返回毒雾矿洞。": "← Both powers returned. Leave Eden to the left.",
  "目标 ← 回到矿洞能力源按 R 修复并卸下碳矿化。": "← R at the cavern source to restore it and unload Mineralization.",
  "目标 ← 矿洞已修复，从左端返回垃圾场。": "← Cavern restored. Return left to the Junkyard.",
  "目标 ← 回出生地能力源按 R 修复并卸下二段跳。": "← R at the first source to restore it and unload Double Jump.",
  "目标 ← 四种能力已卸下，继续向左回家。": "← All four powers returned. Continue left toward home.",
  "目标 → 穿过断崖前往矿洞；空格可二段跳。": "→ Cross the chasms to the cavern. Space again for Double Jump.",
  "目标 → 靠近绿色能力源，按 E 学习二段跳。": "→ Press E at the green source to learn Double Jump.",
  "目标 → 按 I、II、III 的顺序用 C 固化三个节点，打开净化门。": "→ C at I, II, then III to fix the toxin seals and open the gate.",
  "目标 → 靠近矿洞能力源，按 E 学习碳矿化。": "→ Press E at the cavern source to learn Mineralization.",
  "目标 → 绿色能力源 E 学护盾（Q），向右探索伊甸城。": "→ E at the green source to learn Shield (Q). Explore Eden City.",
  "目标 → 紫色能力源 E 学黑穿（F），用于穿过紫色暗壁。": "→ E at the violet source to learn Shadow Pierce (F) for dark walls.",
  "目标 → 守卫已倒下，进入最右侧档案揭开真相。": "→ Warden defeated. Enter the far-right archive to uncover the truth.",
  "目标 → F 穿暗壁，击败右侧伊甸守卫，进入真相档案。": "→ F through the dark wall. Defeat the Warden and enter the archive.",
  "生命  %d / %d": "Health  %d / %d",
  "得分  %04d": "Score  %04d",
  "声音：关闭": "Sound: Off",
  "声音：开启": "Sound: On",
  "简体中文": "简体中文",
  "跳过开场": "Skip opening",
  "第一幕 · 垃圾场": "Act I · The Junkyard",
  "第二幕 · 毒雾矿洞": "Act II · The Toxic Cavern",
  "第三幕 · Eden City": "Act III · Eden City",
  "一座城把废物留在边界之外。你在废墟中醒来，捡起仍能回应大地的提取器。": "A city leaves its waste beyond the walls. You wake among the ruins and find an extractor that still answers the land.",
  "每一份借来的力量都留下代价。追随地面的余绿，穿过矿洞中无法被隐藏的毒雾。": "Every borrowed power leaves a cost. Follow the green life in the soil through the cavern's unhidden poison.",
  "城墙内，春天从不结束。向右寻找真相，再决定是否转身，把绿色还给世界。": "Inside the walls, spring never ends. Seek the truth to the right. Then decide whether to turn back and return green to the world.",
  "踏入旅途": "Begin the journey",
  "继续 · Enter": "Continue · Enter",
  "逃离遗庭": "Beyond Eden",
  "旅途终止": "Journey ended",
  "VICTORY / 挑战完成": "VICTORY / Journey complete",
  "GAME OVER / 检查点恢复": "GAME OVER / Continue at a lantern",
  "得分  %04d\n剩余生命  %d / %d\n用时  %.1f 秒": "Score  %04d\nHealth  %d / %d\nTime  %.1f s",
  "\n累计排放 %.2f kg CO₂ · 已固定 %.2f kg": "\nEmitted %.2f kg CO₂ · Stored %.2f kg",
  "从%s检查点继续": "Continue from %s",
  "孤木": "First Tree",
  "归途手记  ←  与居民共同修复": "Homeward notes ← Rebuild together",
  "旅途手记  ·  垃圾场 → 矿洞 → 伊甸城": "Journey notes · Junkyard → Cavern → Eden",
  "──  旅途终卷  ·  玩家个人可持续行为审计  ──": "──  Journey's end · Sustainability audit  ──",
  "累计排放 · CO₂": "Emitted · CO₂",
  "已固定 · CO₂": "Stored · CO₂",
  "Exergy · 总有效能利用率": "Exergy · Overall useful energy",
  "教学模型：排放与固碳为游戏设定，累计排放不会被修复清零。汽油类比使用 EPA 系数；矿石替代比为可调教学假设。\nExergy 为可用能利用率的游戏化指标，完整公式、参数与 EPA / DOE 来源已写入报告。": "Teaching model: emissions and storage are fictional; restoration does not erase the ledger. Gasoline uses an EPA factor; ore substitution is an adjustable assumption.\nExergy is a gameplay energy indicator. Formulas, parameters and EPA / DOE sources are included in the report.",
  "打开审计报告": "Open audit report",
  "重新导出 HTML / JSON / CSV": "Export HTML / JSON / CSV again",
  "重新开始整局": "Restart journey",
  "返回主菜单": "Main menu",
  "%.1f%%   /   废热 %.1f%%": "%.1f%%   /   Waste %.1f%%",
  "技能                              次数              CO₂": "Ability                         Casts             CO₂",
  "本局未使用技能，没有排放事件。": "No skills used; no emission events.",
  "精准释放 %d 次 · 高频释放 %d 次": "Precise casts %d · Rapid casts %d",
  "力量曾让你独自越过深渊。\n回家的桥，却是和别人一起修好的。": "Power let you cross the abyss alone.\nThe bridge home was built together.",
  "你保住了窗内的春天。\n窗外的人仍替你呼吸。": "You kept the spring behind your window.\nThose outside still breathe its price.",
  "救出居民  %d 人\n共同修复  %d / 3 地区\n循环拆解  %d 个节点 · 回收材料 %.0f kg\n当前污染负荷  %.1f kg（模拟）": "Residents rescued  %d\nRegions restored  %d / 3\nNodes recycled  %d · Material %.0f kg\nCurrent pollution load  %.1f kg (simulated)",
  "现实量级类比：本局模拟排放约对应 %.1f 升汽油燃烧。\n循环经济教学估算：原生矿石替代 %.1f kg。\n这些是游戏数据类比，不是现实排放或减排证明。": "Scale analogy: simulated emissions resemble burning %.1f L of gasoline.\nCircular-economy teaching estimate: %.1f kg of ore substituted.\nThese are game analogies, not proof of real emissions or reductions.",
  "已保存 HTML 可视化报告、JSON 数据和 CSV 事件账本。": "Saved the HTML report, JSON data and CSV event ledger.",
  "导出失败": "Export failed",
  "──  伊甸秘卷 · 被删去的碳账本  ──": "──  Eden's hidden archive · The erased ledger  ──",
  "净土只占 10%，代价却在城外。": "10% is green. The cost lies outside.",
  "垃圾场的人以为伊甸城已经消除了污染。矿工以为自己的毒雾只是必要的过渡。\n能源档案写着另一种答案：净土的四季如春，依靠向城外转移污染与开采成本。\n\n地脉提取器并没有凭空创造能量。你每一次轻易获得的力量，都留下不可抹去的账目。\n这座城把边界内的绿色，称作全世界的绿色。\n\n你可以公开这份账本，救出居民，将提取器改装为逆向循环核心。\n卸下技能不是独自变弱：和居民共同修桥、循环拆解，把绿色还给世界。": "The Junkyard believed Eden had ended pollution. Miners thought their poison was a necessary transition.\nThe archive tells another story: Eden's spring relies on exporting pollution and extraction costs.\n\nThe extractor never created energy from nothing. Every power you gained left an enduring entry.\nThis city called the green within its walls the green of the entire world.\n\nYou can expose the ledger, rescue the residents, and rebuild the extractor as a reverse-cycle core.\nReturn your powers, rebuild together, and bring green back to the world.",
  "觉醒发生在你的选择里。A 路线转为绿色形态；B 路线保留红色形态。": "Your choice awakens you. A becomes the green form; B keeps the red form.",
  "A  ·  公开真相，改装核心，与居民返程修复": "A  ·  Reveal the truth, reverse the core, restore the world together",
  "B  ·  留在伊甸城，维持污染向城外转移": "B  ·  Stay in Eden City and continue exporting pollution",
  "排放、固碳和材料质量均为游戏模型。汽油类比使用 EPA 8.887 kg CO2/美制加仑，仅作量级比较；矿石替代比为教学假设。累计排放不会被抵销或清零。": "Emissions, storage and material mass are game models. Gasoline uses the EPA factor of 8.887 kg CO2 per US gallon for a scale analogy only. Ore substitution is a teaching assumption. Gross emissions are never offset or erased.",
  "靠近能力源按 E 吸收，返程在原处按 R 交还。": "E learns at a source; R returns a power on the homeward journey.",
  "吸收%s；%s": "Learned %s; %s",
  "土地已荒芜，返程请在原处交还。": "the soil has bleached. Return the power on your way home.",
  "光刃地点仍待设计确定（当前为接口试用）。": "the blade's formal source is undecided (integration trial).",
  "选择逆向循环路线后，和获救居民一起修复这片土地。": "Choose restoration, then rebuild this land with the rescued residents.",
  "请回到%s交还%s。": "Return to %s to unload %s.",
  "光刃交还被阻止：关卡尚未确认无攻击能力的撤离通路。": "Blade return blocked: a safe unarmed escape route has not been confirmed.",
  "已交还%s：%s": "Returned %s: %s",
  "进入%s，检查点已更新。": "Entering %s. Lantern checkpoint updated.",
  "已返回%s检查点；本局能力、交还状态和已击败怪物均保留。": "Returned to %s. Abilities, returned powers and defeated enemies are preserved.",
  "检查点已点亮：%s": "Lantern lit: %s",
  "伙伴已获救。向左返程交还能力，带他们回家。": "Your companions are safe. Return left, give back the powers, and bring them home.",
  "逆向循环核心已启动。档案门口按 R 与 3 位居民共建通路；向左回原能力源卸下技能。": "Reverse-cycle core awakened. R at the archive to rebuild with three residents, then return left to unload each power.",
  "你留在了伊甸城。污染仍被转移到城外。": "You stayed in Eden City. Pollution is still exported beyond the walls.",
  "近战攻击模板 / 测试房": "Melee templates / Training room",
  "左键：短范围挥砍（80 px）     右键：长距离挥砍（180 px）\nA/D 移动改变朝向；空格跳跃。黄色/青色框为对应攻击范围。": "LMB: close slash (80 px)     RMB: reach slash (180 px)\nA/D moves and turns; Space jumps. Yellow/cyan outlines show attack reach.",
  "重置木桩和角色": "Reset dummies & position",
  "测试房木桩为 3 HP，便于观察重复命中；正式验证关卡的怪物仍是一击倒。": "Training dummies have 3 HP to show repeat hits; normal enemies still fall to one slash.",
  "生命  100 / 100": "Health  100 / 100",
  "得分  0000": "Score  0000",
  "A/D 移动 · 空格跳跃 · Shift 快跑/冲刺 · Q 护盾 · E 吸收 · R 交还 · 左短砍 / 右长砍": "A/D Move · Space Jump · Shift Run · Q Shield · E Learn · R Return · LMB / RMB Slash",
  "E D E N G U I L T    ·    遗 庭": "E D E N G U I L T    ·    A BORROWED SPRING",
  "伊甸之罪": "EdenGuilt",
  "你获得的每一份力量，都留下一笔账。\n伊甸城的春天，究竟由谁承担？\n\n垃圾场  /  毒雾矿洞  /  伊甸城": "Every power leaves a debt.\nWho pays for Eden's spring?\n\nJunkyard  /  Toxic Cavern  /  Eden City",
  "力量终有代价，归途仍待有人同行。\n三幕旅途  ·  两种抉择  ·  一份留给世界的账本": "Power has a price. The road home need not be walked alone.\nThree acts  ·  Two choices  ·  One enduring ledger",
  "──  踏入遗庭  ──": "──  Enter the ruins  ──",
  "开始游戏": "Start game",
  "近战模板测试": "Melee training",
  "A/D 移动 · 空格跳跃 · Shift 快跑\n左键短砍 / 右键长砍\nE 学习 · C 矿化 · Q 护盾 · F 黑穿\nT 交谈 · V 拆解 · R 修复 / 卸下\n精准节奏提高能效，连发积累废热\n寻找真相，选择结局 A / B": "A/D Move · Space Jump · Shift Run\nLMB Close slash / RMB Reach slash\nE Learn · C Mineralize · Q Shield · F Pierce\nT Talk · V Recycle · R Restore / Unload\nKeep rhythm for efficiency; rapid casts build heat.\nFind the truth. Choose ending A or B.",
  "可用 Tab 切换按钮，Enter 确认": "Tab selects · Enter confirms",
  "检查点继续：保留能力与世界进度，恢复生命\n重新开始整局：重置全部进度": "Continue: retain abilities and world progress; restore health\nRestart: begin a new journey with all progress reset",
  "从检查点继续": "Continue at lantern",
  "长距离挥砍": "Reach Slash",
  "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>EdenGuilt · Sustainability Audit Report</title><style>\nbody{margin:0;background:#1b1510;color:#e7dcc0;font:16px/1.7 Georgia,\"SimSun\",serif}main{max-width:1040px;margin:auto;padding:38px}h1{font-size:34px}h2{font-size:23px;color:#c8ab72}small,.muted{color:#b4a58a}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{border:1px solid #705935;padding:18px;background:#292016}.number{font-size:30px;color:#e7ba71}table{width:100%%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #51432d}a{color:#d2b57e}svg{width:100%%}blockquote{border-left:3px solid #a78d53;padding:15px;background:#2c2418}@media(max-width:680px){.cards{grid-template-columns:1fr}main{padding:20px}}\n</style><main><small>EDENGUILT / SUSTAINABILITY AUDIT REPORT · 玩家个人可持续行为审计</small><h1>%s</h1><blockquote>%s</blockquote>\n<div class=\"cards\"><div class=\"card\">累计排放 CO₂<div class=\"number\">%.2f kg</div><small>永久历史，不因修复清零</small></div><div class=\"card\">已固定 CO₂<div class=\"number\">%.2f kg</div><small>单列矿化与社区固碳模型</small></div><div class=\"card\">有效能利用率<div class=\"number\">%.1f%%</div><small>总有效功 / 总输入；废热 %.1f%%</small></div></div>\n<h2>三幕排放去向</h2>%s<table><tr><th>场景</th><th>排放</th><th>固碳</th><th>技能次数</th></tr>%s</table>\n<h2>技能明细</h2><table><tr><th>技能</th><th>次数</th><th>排放</th></tr>%s</table>\n<h2>共同修复与循环经济</h2><p>救出居民 %d 人 · 修复 %d / 3 地区 · 循环拆解 %d 个节点 · 回收材料 %.1f kg。<br>按游戏教学假设 1 kg 回收材料替代 %.1f kg 原生矿石，对应 %.1f kg 矿石替代量。这不是现实中的电子垃圾回收或采矿实测。</p>\n<h2>现实量级类比</h2><p>本局模拟排放 %.2f kg CO₂，按 EPA 的汽油燃烧因子类比约 %.2f 升汽油。只用于帮助理解量级；不代表玩家在现实中排放、减少或抵销了这些碳。</p>\n<h2>方法与来源</h2><p>%s</p><p>Exergy 是可用能利用率的游戏化指标；能量为无量纲模型，不是完整热力学或生命周期核算。未使用技能时利用率记为 0，不填造数据。详细事件仅保留前 %d 条，省略 %d 条；汇总包含所有事件。</p>\n<p><a href=\"%s\">EPA · 汽油燃烧 8.887 kg CO₂ / 美制加仑</a><br><a href=\"%s\">DOE · 碳矿化路径</a></p><small>配套 JSON 保存汇总、采用参数和事件；CSV 保存逐次技能记录。报告不声称具有现实碳核查效力。</small></main></html>": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>EdenGuilt · Sustainability Audit Report</title><style>\nbody{margin:0;background:#1b1510;color:#e7dcc0;font:16px/1.7 Georgia,\"SimSun\",serif}main{max-width:1040px;margin:auto;padding:38px}h1{font-size:34px}h2{font-size:23px;color:#c8ab72}small,.muted{color:#b4a58a}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{border:1px solid #705935;padding:18px;background:#292016}.number{font-size:30px;color:#e7ba71}table{width:100%%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #51432d}a{color:#d2b57e}svg{width:100%%}blockquote{border-left:3px solid #a78d53;padding:15px;background:#2c2418}@media(max-width:680px){.cards{grid-template-columns:1fr}main{padding:20px}}\n</style><main><small>EDENGUILT / SUSTAINABILITY AUDIT REPORT · Player Sustainability Audit</small><h1>%s</h1><blockquote>%s</blockquote>\n<div class=\"cards\"><div class=\"card\">Gross emissions CO₂<div class=\"number\">%.2f kg</div><small>Permanent history; restoration does not erase it</small></div><div class=\"card\">Stored CO₂<div class=\"number\">%.2f kg</div><small>Separate mineralization and community storage model</small></div><div class=\"card\">Useful energy efficiency<div class=\"number\">%.1f%%</div><small>Useful work / total input; waste %.1f%%</small></div></div>\n<h2>Emissions across three acts</h2>%s<table><tr><th>Level</th><th>Emissions</th><th>Storage</th><th>Skill casts</th></tr>%s</table>\n<h2>Ability breakdown</h2><table><tr><th>Ability</th><th>Casts</th><th>Emissions</th></tr>%s</table>\n<h2>Community restoration and circular economy</h2><p>Residents rescued: %d · Regions restored: %d / 3 · Nodes recycled: %d · Material recovered: %.1f kg.<br>The teaching assumption of 1 kg recovered material substituting %.1f kg virgin ore gives %.1f kg ore substituted. This is not a real-world e-waste or mining measurement.</p>\n<h2>Real-world scale analogy</h2><p>This run simulated %.2f kg CO₂, comparable in scale to burning %.2f L of gasoline using the EPA factor. This does not represent actual emissions, reductions or offsets.</p>\n<h2>Method and sources</h2><p>%s</p><p>Exergy is a gameplay indicator of useful energy. Energy is a dimensionless model, not a full thermodynamic or life-cycle calculation. Efficiency is 0 when no skill was used. Detailed events retain the first %d entries and omit %d; aggregates include all events.</p>\n<p><a href=\"%s\">EPA · Gasoline combustion: 8.887 kg CO₂ / US gallon</a><br><a href=\"%s\">DOE · Carbon mineralization pathway</a></p><small>The JSON contains aggregates, parameters and events; the CSV records each accepted skill use. This report makes no claim to real-world carbon verification.</small></main></html>",
  "毒素负荷 %.0f%% · 封印 %d / 3": "Toxin %.0f%% · Seals %d / 3",
  "离开毒雾可恢复 · C 按编号封住毒源": "Leave fog to recover · C seals vents in order"
}
